<?xml version="1.0" encoding="utf-8"?>
<!--
  v3.2：点击实况胶囊展开的播放面板。

  结构分两层，是为了做「胶囊长大成卡片」的动画：
   - panel_card：只负责背景（圆角矩形）与尺寸。展开时它的 layout 宽高/位置
     从胶囊矩形连续插值到卡片矩形，背景圆角同步从胶囊半径变到 30dp。
   - panel_content：内容层。代码里把它的宽高固定成**最终尺寸**，
     动画过程中不重排（避免文字换行抖动），只做 alpha 淡入淡出，
     超出 panel_card 的部分由 clipChildren 裁掉。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/panel_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/bg_ark_panel"
        android:clickable="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/panel_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <!-- 封面 + 曲目信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!--
                  v3.12：封面位改成「双图插槽」做左右轮播。
                  clipChildren=true 让滑出/滑入的图被裁在 62dp 方框内，
                  切换时看起来是轮播而不是整块飘出去。
                -->
                <FrameLayout
                    android:id="@+id/panel_cover_slot"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <ImageView
                        android:id="@+id/panel_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ark_panel_cover"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_flymeark" />

                    <ImageView
                        android:id="@+id/panel_cover_b"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ark_panel_cover"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/panel_title"
                        style="@style/ArkPanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ark_panel_unknown" />

                    <TextView
                        android:id="@+id/panel_artist"
                        style="@style/ArkPanelSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

            <!-- 进度条 -->
            <com.flymeark.ArkProgressBar
                android:id="@+id/panel_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="16dp" />

            <!-- 时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/panel_time_current"
                    style="@style/ArkPanelTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/panel_time_total"
                    style="@style/ArkPanelTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00" />
            </LinearLayout>

            <!-- 控制按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/panel_prev"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ark_panel_prev"
                    android:padding="11dp"
                    android:src="@drawable/ic_ark_prev" />

                <ImageView
                    android:id="@+id/panel_play"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="26dp"
                    android:background="@drawable/bg_ark_play_btn"
                    android:contentDescription="@string/ark_panel_play"
                    android:padding="16dp"
                    android:src="@drawable/ic_ark_play" />

                <ImageView
                    android:id="@+id/panel_next"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ark_panel_next"
                    android:padding="11dp"
                    android:src="@drawable/ic_ark_next" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
