<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.6：点击实况胶囊展开的播放面板。

  视觉参照：封面 + 曲名/歌手 + 进度条与时间 + 上一首/播放暂停/下一首。
  卡片本身消费点击（不关闭），空白区域点击关闭。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/panel_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/bg_ark_panel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <!-- 封面 + 曲目信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/panel_cover"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:contentDescription="@string/ark_panel_cover"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_flymeark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/panel_title"
                    style="@style/ArkPanelTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ark_panel_unknown" />

                <TextView
                    android:id="@+id/panel_artist"
                    style="@style/ArkPanelSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- 进度条 -->
        <com.flymeark.ArkProgressBar
            android:id="@+id/panel_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="16dp" />

        <!-- 时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panel_time_current"
                style="@style/ArkPanelTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/panel_time_total"
                style="@style/ArkPanelTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00" />
        </LinearLayout>

        <!-- 控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/panel_prev"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ark_panel_prev"
                android:padding="11dp"
                android:src="@drawable/ic_ark_prev" />

            <ImageView
                android:id="@+id/panel_play"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="26dp"
                android:background="@drawable/bg_ark_play_btn"
                android:contentDescription="@string/ark_panel_play"
                android:padding="16dp"
                android:src="@drawable/ic_ark_play" />

            <ImageView
                android:id="@+id/panel_next"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ark_panel_next"
                android:padding="11dp"
                android:src="@drawable/ic_ark_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
