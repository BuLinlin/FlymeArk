<?xml version="1.0" encoding="utf-8"?>
<!--
  v3.2：点击实况胶囊展开的播放面板。

  结构分两层，是为了做「胶囊长大成卡片」的动画：
   - panel_card：只负责背景（圆角矩形）与尺寸。展开时它的 layout 宽高/位置
     从胶囊矩形连续插值到卡片矩形，背景圆角同步从胶囊半径变到 30dp。
   - panel_content：内容层。代码里把它的宽高固定成**最终尺寸**，
     动画过程中不重排（避免文字换行抖动），只做 alpha 淡入淡出，
     超出 panel_card 的部分由 clipChildren 裁掉。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <!--
      v3.13.3：背景改成系统同款玻璃。
      模糊由窗口 blurBehindRadius（真实壁纸）完成；玻璃染色 scrim 在代码里
      根据 SystemUI 推来的深浅模式铺在 panel_root 上（对齐媒体卡 0xB2 染色）。
      v3.13 的「专辑封面糊满全屏」背景整体移除。
    -->

    <FrameLayout
        android:id="@+id/panel_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/bg_ark_panel"
        android:clickable="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/panel_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <!-- 封面 + 曲目信息（v3.14.1：右上角显示媒体 App 图标，参考用户提供的参考图） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <!--
                  v3.12：封面位改成「双图插槽」做左右轮播。
                  clipChildren=true 让滑出/滑入的图被裁在 62dp 方框内，
                  切换时看起来是轮播而不是整块飘出去。
                -->
                <FrameLayout
                    android:id="@+id/panel_cover_slot"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <ImageView
                        android:id="@+id/panel_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ark_panel_cover"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_flymeark" />

                    <ImageView
                        android:id="@+id/panel_cover_b"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/ark_panel_cover"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/panel_title"
                        style="@style/ArkPanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ark_panel_unknown" />

                    <TextView
                        android:id="@+id/panel_artist"
                        style="@style/ArkPanelSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="" />
                </LinearLayout>

                <!-- 当前媒体 App 图标（右上角，参考图四排版） -->
                </LinearLayout>

                <!-- 当前媒体 App 图标（右上角，参考图四排版） -->
                <ImageView
                    android:id="@+id/panel_app_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|end"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <!--
              进度条：v3.13 起可拖动 seek。
              触摸热区需要高度，view 给 25dp，线画在垂直中心（3dp），
              上下用负 margin 补偿保持原视觉间距（16dp / 7dp）。
            -->
            <com.flymeark.ArkProgressBar
                android:id="@+id/panel_progress"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="4dp" />

            <!-- 时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/panel_time_current"
                    style="@style/ArkPanelTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/panel_time_total"
                    style="@style/ArkPanelTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00" />
            </LinearLayout>

            <!--
              控制按钮（v3.14.1）：播放键绝对居中（用户反馈跑偏）。
              左区 ❤ + 上一首（靠拢播放键），右区下一首（对称位置），
              与参考图四一致；右侧留白给后续的输出切换/歌词按钮。
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/panel_fav"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ark_panel_fav"
                        android:padding="11dp"
                        android:src="@drawable/ic_ark_fav" />

                    <ImageView
                        android:id="@+id/panel_prev"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="18dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ark_panel_prev"
                        android:padding="11dp"
                        android:src="@drawable/ic_ark_prev" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/panel_play"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_ark_play_btn"
                    android:contentDescription="@string/ark_panel_play"
                    android:padding="16dp"
                    android:src="@drawable/ic_ark_play" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/panel_next"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="18dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ark_panel_next"
                        android:padding="11dp"
                        android:src="@drawable/ic_ark_next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
