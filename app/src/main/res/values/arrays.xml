<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LSPosed 推荐作用域：安装后管理器据此提示勾选。
         系统进程必须勾选，否则 [ArkLiveAllowHook] 不加载。
         v3.15.30 起同时声明 `system` 与 `android` 两个 key：不同版本的 LSPosed 对
         system_server 的展示名不一致（本机 Flyme 上「Flyme 系统服务(android)」带推荐标签，
         「系统框架(system)」没有），两个都声明才能保证用户在任何一台上都能看到推荐提示。 -->
    <string-array name="xposed_scope">
        <!-- 系统进程（system_server）：感知实况通知开关的「用户动作」，关闭实时生效 -->
        <item>system</item>
        <item>android</item>
        <!-- 目标播放器：QQ音乐（打开魅族状态栏歌词通道） -->
        <item>com.tencent.qqmusic</item>
        <!-- 目标播放器：网易云音乐（同为魅族状态栏歌词协议，v3.15 起支持） -->
        <item>com.netease.cloudmusic</item>
        <!-- 消息实况：微信（把消息通知渲染成实况胶囊，v3.15.18） -->
        <item>com.tencent.mm</item>
        <!-- 消息实况：QQ（把消息通知渲染成实况胶囊，v3.15.18） -->
        <item>com.tencent.mobileqq</item>
        <!-- 导航实况：高德地图（把常驻导航通知补成实况胶囊，v3.15.51） -->
        <item>com.autonavi.minimap</item>
        <!-- SystemUI：歌词胶囊放行 + 封面 + 点击展开 + 媒体键代派 -->
        <item>com.android.systemui</item>
        <!-- 设置：把 QQ音乐 / 网易云 / 微信 / QQ 登记进「实况通知」开关列表 -->
        <item>com.android.settings</item>
    </string-array>
</resources>
