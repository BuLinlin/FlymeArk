    <!-- 品牌 / 轨道 / 分割线 -->
    <color name="ark_brand">#FF2F6BFF</color>
    <color name="ark_brand_on">#FFFFFFFF</color>
    <color name="ark_track">#FFD9DEE7</color>
    <color name="ark_divider">#FFE4E8EF</color>

    <!-- 82% 玻璃：配合窗口背景模糊使用 -->
    <color name="ark_glass_top">#D1FDFEFF</color>
    <color name="ark_glass_bottom">#D1EFF3F8</color>
