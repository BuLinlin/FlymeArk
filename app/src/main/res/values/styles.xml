<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 点击实况胶囊展开的播放面板（顶部悬浮半透明窗口） -->
    <style name="Theme.Ark.CapsulePanel" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!--
        v3.15.44：面板内文字统一到 IslandTokens 的三级语义色 + 18/14/12sp。
        色值统一走 @color/ark_*（values/colors.xml 与 values-night/colors.xml 覆盖），
        组件里不再写十六进制魔法数字。
        fontFamily + textFontWeight=600 对应设计稿的 SemiBold；textFontWeight 在
        API 28+ 生效，低版本仍有 sans-serif-medium 兜底。
    -->
    <style name="ArkPanelTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ark_text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ArkPanelSubtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ark_text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ArkPanelTime">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ark_text_tertiary</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!--
        v3.15.46：通知卡专用三档（对齐设计稿 NotificationCapsule + IslandComponents.GlassSurface）
         - ArkPanelTitleSmall：群名/发送者标题，设计稿 TypeTitle = 16sp SemiBold
         - ArkPanelBody      ：正文，TypeBody = 14sp，行高 20sp（= 14sp + 6sp extra）
         - ArkPanelCta       ：底部「应用 · 进入会话」主 CTA，14sp Medium 一级色
    -->
    <style name="ArkPanelTitleSmall">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ark_text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ArkPanelBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ark_text_primary</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:maxLines">6</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ArkPanelCta">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/ark_text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!--
        v3.15.61：导航展开卡（设计稿 nav.html）。
        字号全部取设计稿的 px 值当 sp 用（1x 量取），字重走 sans-serif-medium +
        textFontWeight 500/600，与面板其它卡片同一套写法。
        色值只是首帧占位：ArkNavPanelActivity.applyPalette() 会按 p.light 重新下发，
        不吃 values-night —— 否则「系统夜间 + 亮壁纸」会错配（与消息卡同一套规则）。
    -->
    <style name="ArkNavLive">
        <item name="android:textSize">11.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ark_brand</item>
        <item name="android:letterSpacing">0.024</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="ArkNavDest">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/ark_text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ArkNavInstr">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ark_text_primary</item>
        <item name="android:letterSpacing">-0.006</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ArkNavSub">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ark_text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ArkNavValue">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ark_text_primary</item>
        <item name="android:letterSpacing">-0.0125</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ArkNavLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ark_text_tertiary</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="ArkNavButton">
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ark_text_primary</item>
        <item name="android:letterSpacing">0.016</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="ArkNavSource">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/ark_text_tertiary</item>
        <item name="android:letterSpacing">0.0174</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
