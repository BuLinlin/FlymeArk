<?xml version="1.0" encoding="utf-8"?>
<!--
    v3.15.44：96% 不透明降级玻璃（系统禁用窗口模糊 / 高对比文字档）。
    与 bg_ark_panel.xml 结构完全一致，只是色值切到 @color/ark_glass_*_opaque。
    面板首帧占位用；运行时卡片由 ArkLiquidGlassDrawable 的 96% 档绘制。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/ark_glass_top_opaque"
        android:endColor="@color/ark_glass_bottom_opaque"
        android:type="linear" />
    <corners android:radius="@dimen/ark_radius_card" />
    <stroke
        android:width="@dimen/ark_stroke"
        android:color="@color/ark_highlight" />
</shape>
