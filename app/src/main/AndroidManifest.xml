<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仅保留一条：从 SystemUI 后台拉起面板 Activity 的启动豁免兜底。
         本模块不发通知、不驻留 Service、不渲染悬浮窗。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- v3.15.9：targetSdk 36 的包可见性限制。
         面板（模块自身进程，非 SystemUI）要用 PackageManager.getApplicationIcon()
         显示右上角媒体 App 图标，不声明 queries 会直接抛 NameNotFoundException，
         图标被 catch 成 GONE —— 这就是「右上角图标一直没出现」的原因。 -->
    <queries>
        <package android:name="com.tencent.qqmusic" />
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_flymeark"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ark.CapsulePanel">

        <!-- 点击实况胶囊展开的原生播放面板。
             exported=true：由 SystemUI 进程（不同 uid）按类名显式拉起；
             singleTask + 独立任务栈：不把任何界面带进最近任务。 -->
        <activity
            android:name=".ArkCapsulePanelActivity"
            android:exported="true"
            android:theme="@style/Theme.Ark.CapsulePanel"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="com.flymeark.panel"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|fontScale"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:showWhenLocked="true" />

        <!-- LSPosed 模块元数据 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="一个针对魅族实况通知的优化模块插件。在 LSPosed 中勾选并启用推荐应用，然后到 设置-通知与状态栏-实况通知 里打开对应 App 的开关即可&#10;开发者：多爱梦" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <!-- 推荐作用域（含系统框架 android，安装时即可勾选） -->
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
